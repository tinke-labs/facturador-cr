<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2008 sp1 (http://www.altova.com) by uNDER (HOME) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="ResumenPeriodoVentas">
		<xs:complexType>
			<xs:sequence maxOccurs="unbounded">
				<xs:element name="Periodo">
					<xs:complexType>
						<xs:sequence maxOccurs="unbounded">
							<xs:element name="Encabezado">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="FechaEmisionDoc" type="xs:dateTime">
											<xs:annotation>
												<xs:documentation>Fecha en la que se genera el documento Electrónico</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="Emisor">
											<xs:annotation>
												<xs:documentation>Información completa de los Datos del Emisor del Documento Electrónico</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:attribute name="NombreEmisor" use="required">
													<xs:annotation>
														<xs:documentation>Nombre del la persona Física o Jurídica que emite el Documento Electrónico</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="80"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="NumCedulaEmisor" use="required">
													<xs:annotation>
														<xs:documentation>Cédula Física o Jurídica del Emisor del Documento Electrónico</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:unsignedLong">
															<xs:totalDigits value="10"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="NombreComercialEmisor" use="required">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="80"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="DireccionEmisor">
													<xs:annotation>
														<xs:documentation>Esta etiqueta se debe llenar con información cuando se trata de una factura, en el caso de Nota de Crédito o Débito no será requerido</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="80"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="NumeroTelEmisor">
													<xs:annotation>
														<xs:documentation>Esta etiqueta se debe llenar con información cuando se trata de una factura, en el caso de Nota de Crédito o Débito no será requerido</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:integer">
															<xs:totalDigits value="8"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="NumeroFaxEmisor" use="optional">
													<xs:simpleType>
														<xs:restriction base="xs:integer">
															<xs:totalDigits value="8"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="CorreoElectronicoEmisor">
													<xs:annotation>
														<xs:documentation>Esta etiqueta se debe llenar con información cuando se trata de una factura, en el caso de Nota de Crédito o Débito no será requerido</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="30"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
											</xs:complexType>
										</xs:element>
										<xs:element name="Periodo">
											<xs:complexType>
												<xs:attribute name="Mes" use="required">
													<xs:simpleType>
														<xs:restriction base="xs:byte">
															<xs:totalDigits value="2" fixed="false"/>
															<xs:minInclusive value="2"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="Año" use="required">
													<xs:simpleType>
														<xs:restriction base="xs:byte">
															<xs:totalDigits value="4"/>
															<xs:minInclusive value="4"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="Detalle">
								<xs:complexType>
									<xs:sequence maxOccurs="unbounded">
										<xs:element name="Linea">
											<xs:complexType>
												<xs:sequence maxOccurs="unbounded">
													<xs:element name="FechaEmisionDoc">
														<xs:annotation>
															<xs:documentation>Fecha y Hora de la Transacción</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:simpleContent>
																<xs:extension base="xs:dateTime"/>
															</xs:simpleContent>
														</xs:complexType>
													</xs:element>
													<xs:element name="NumConsecutivo">
														<xs:annotation>
															<xs:documentation>Número consecutivo del Documento Electrónico que es aceptado/rechazado</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:int">
																<xs:totalDigits value="13"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="NombreReceptor">
														<xs:annotation>
															<xs:documentation>Mombre del Emisor del documento electrónico</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="80"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="NumCedulaReceptor">
														<xs:annotation>
															<xs:documentation>Número de Cédula Física o jurídica del Emisor</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:int">
																<xs:totalDigits value="10"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="NumOrdenCompra" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:int">
																<xs:totalDigits value="13"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="FechaEmisionOrden" type="xs:dateTime" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Fecha y Hora de la Orden de Compra</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="TipoDoc" nillable="false">
														<xs:annotation>
															<xs:documentation>Tipo de Documento Electrónico: 01 Factura, 02 Nota de Débito, 03 Nota de Crédito</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:int">
																<xs:totalDigits value="2"/>
																<xs:pattern value=""/>
																<xs:pattern value=""/>
																<xs:enumeration value="01"/>
																<xs:enumeration value="02"/>
																<xs:enumeration value="03"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="TotalVentasExcentas" type="Monto">
														<xs:annotation>
															<xs:documentation>Monto Total de las Ventas Excentas </xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="TotalExportaciones" type="Monto">
														<xs:annotation>
															<xs:documentation>Monto Total de las exportaciones</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="TotalVentasGravadas" type="Monto">
														<xs:annotation>
															<xs:documentation>Monto Total de las Ventas Gravadas</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="TotalImpuestoVtas" type="Monto">
														<xs:annotation>
															<xs:documentation>Monto Total del Impuesto Cobrado</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="TotalVentas" type="Monto">
														<xs:annotation>
															<xs:documentation>Monto Total Mensual de Ventas</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="Monto">
		<xs:annotation>
			<xs:documentation>Tipo de dato Utilizado para montos</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="28"/>
			<xs:fractionDigits value="8"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Cantidad">
		<xs:annotation>
			<xs:documentation>Tipo de dato Utilizado para cantidades</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="28"/>
			<xs:fractionDigits value="8"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
